# ==============================================================================
# DevOps Repository Auditing Agent - Environment Configuration
# ==============================================================================
#
# PRIMARY RECOMMENDED FREE API: Google Gemini API (100% Free, Zero Cost)
# Get a free key at: https://aistudio.google.com/
# Free Quota: 1,500 requests/day, 15 requests/minute, 1,000,000 tokens/minute
# Zero cost, no credit card required.
#
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ALTERNATIVE FREE API: Groq Cloud (100% Free)
# Get a free key at: https://console.groq.com/keys
#
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ALTERNATIVE FREE API: OpenRouter Free Models
# Get a free key at: https://openrouter.ai/keys
#
OPENROUTER_API_KEY=

# OPTIONAL: OpenAI API (Paid, if you already have credits)
#
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AGENT EXECUTION CONFIGURATION
# Provider options: gemini (default), groq, openrouter, openai, offline
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_MAX_STEPS=12
DEFAULT_TEMPERATURE=0.1
LOG_LEVEL=INFO
