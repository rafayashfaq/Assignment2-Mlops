# ==============================================================================
# DevOps Repository Auditing Agent - Environment Configuration
# ==============================================================================
#
# RECOMMENDED FREE API: Groq Cloud (100% Free, Zero Cost)
# Get a free key at: https://console.groq.com/keys
# Quota: 14,400 requests/day, 30 requests/minute, 128k context window
#
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ALTERNATIVE FREE API: Google Gemini Free Tier
# Get a free key at: https://aistudio.google.com/
# Quota: 1,500 requests/day, 15 requests/minute
#
GEMINI_API_KEY=

# ALTERNATIVE FREE API: OpenRouter Free Models
# Get a free key at: https://openrouter.ai/keys
#
OPENROUTER_API_KEY=

# OPTIONAL: OpenAI API (Paid, if you already have credits)
#
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AGENT EXECUTION CONFIGURATION
# Provider options: groq (default), gemini, openrouter, openai, offline
DEFAULT_LLM_PROVIDER=groq
DEFAULT_MAX_STEPS=12
DEFAULT_TEMPERATURE=0.1
LOG_LEVEL=INFO
